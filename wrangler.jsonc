{
    "name": "bukasir-fe",
    "compatibility_date": "2026-01-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": ".open-next/worker.js",
    "assets": {
        "directory": ".open-next/assets"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "bukasir-fe"
        }
    ]
}